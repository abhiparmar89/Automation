<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Q2 Appium Suite"
       parallel="methods"
       thread-count="2">

    <listeners>
        <listener class-name="com.q2.framework.listeners.TestListener"/>
    </listeners>

    <test name="Parallel Tests">

        <classes>
            <class name="com.q2.framework.tests.ParallelTest"/>
        </classes>

    </test>

</suite>